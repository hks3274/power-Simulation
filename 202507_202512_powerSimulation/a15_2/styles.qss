/* styles.qss - QT 애플리케이션 스타일시트 */

/* 메인 윈도우 */
QMainWindow {
    background: #f8f9fa;
}

/* MDI Area */
QMdiArea {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f8f9fa, stop:1 #e9ecef);
    border: none;
}

QMdiArea::separator {
    background: #dee2e6;
    width: 2px;
    height: 2px;
}

/* MDI 서브윈도우 */
QMdiSubWindow {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin: 2px;
}

QMdiSubWindow::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a90e2, stop:1 #357abd);
    color: white;
    padding: 8px 12px;
    font-weight: bold;
    font-size: 12px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border: none;
}

QMdiSubWindow::close-button {
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 3px;
    padding: 2px;
    margin: 2px;
    width: 16px;
    height: 16px;
}

QMdiSubWindow::close-button:hover {
    background: rgba(255,255,255,0.3);
}

QMdiSubWindow::minimize-button {
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 3px;
    padding: 2px;
    margin: 2px;
    width: 16px;
    height: 16px;
}

QMdiSubWindow::minimize-button:hover {
    background: rgba(255,255,255,0.3);
}

QMdiSubWindow::maximize-button {
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 3px;
    padding: 2px;
    margin: 2px;
    width: 16px;
    height: 16px;
}

QMdiSubWindow::maximize-button:hover {
    background: rgba(255,255,255,0.3);
}

/* 메뉴바 */
QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #dee2e6;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
    margin: 2px;
}

QMenuBar::item:selected {
    background: #e9ecef;
}

/* 메뉴 */
QMenu {
    background: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 8px 16px;
    margin: 2px 4px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #4a90e2;
    color: white;
}

/* 상태바 */
QStatusBar {
    background: #ffffff;
    border-top: 1px solid #dee2e6;
    padding: 4px;
}

/* 툴버튼 (시작/일시정지 버튼) */
QToolButton {
    padding: 4px 10px;
    border: 1px solid #cfcfcf;
    border-radius: 6px;
}

QToolButton:hover {
    background-color: #e9e9e9;
}

QToolButton:checked {
    background-color: #444;
    color: #fff;
    border-color: #444;
}

QToolButton:pressed {
    background-color: #d0d0d0;
}
