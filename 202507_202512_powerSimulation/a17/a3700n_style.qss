QMainWindow {
    background-color: #599cf7;
}

/*Qmenubar */

QMenuBar {
    background-color: #0c39b3;
    color: white;
}


Qmenubar:hover {
    background-color: #599cf7;
    color: white;
}

/* 전체 툴바 영역 */

QToolBar {
    background-color: #0c39b3;
    border: none;
    spacing: 0px;
}

/* === 툴바 버튼(QAction → QToolButton) === */
QToolButton {
    background-color: #0c39b3;
    color: white;
    border: none;
    min-width: 110px;
    min-height: 40px;
    font-size:12pt;
    font-weight: bold;
}

/* === 마우스 올렸을 때 === */
QToolButton:hover {
    background-color: #599cf7;
    color: white;
}

/* === 클릭(체크)된 상태 === */
QToolButton:checked {
    background-color: #599cf7;
    color: white;
    border: none;
}

/* === 버튼 사이 구분선 제거 === */
QToolBar::separator {
    width: 0px;
    height: 0px;
}

/* 리스트 영역 */

/* === 왼쪽 리스트 영역 === */
QListWidget {
    background-color: #b4b5b8;
    border: none;
    outline: 0;
    min-width: 100px;
    margin: 5px 0px 5px 5px;
}

/* === 리스트 아이템 기본 상태 === */
QListWidget::item {
    background-color: #e5e5e5;
    color: #222;
    padding: 10px 6px;
    border-bottom: 2px solid #f2f2f2;
}

/* === 마우스를 올렸을 때 === */
QListWidget::item:hover {
    background-color: white;
}

/* === 선택된 항목 === */
QListWidget::item:selected {
    background-color: white;
    color: #222;
    border: none;
    font-weight: bold;
}


/* 오른쪽 영역 */
/* === 오른쪽 전체 객체 === */
QWidget#content {
    background-color: white;
    margin : 5px 5px 5px 0px;
}
QLabel#title {
    font-size : 18px;
    font-weight : bold;

}

/* === 이름(A,B,C,average,frequency 등..) 전체=== */
QLabel#name {
    font-size : 22px;
    font-weight : bold;

}


/* === 값 전체 ===  */
QLabel#val {
    font-size : 30px;
    color : blue;
    font-weight : bold;

}


/* === 단위 전체 === */
QLabel#u {
    font-size : 22px;
    color : #666;
    font-weight : bold;

}
